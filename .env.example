###############################################################################
# homelab-ai-stack - Environment Configuration
#
# Copy this file to .env and customize:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to version control.
###############################################################################

# =============================================================================
# SECRETS - Generate these with: openssl rand -hex 32
# =============================================================================

# Master key for LiteLLM admin access (REQUIRED)
LITELLM_MASTER_KEY=change-me-generate-with-openssl-rand-hex-32

# Open WebUI internal secret key (REQUIRED)
OPENWEBUI_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Gateway admin API key - used to manage gateway API keys (REQUIRED)
GATEWAY_ADMIN_API_KEY=change-me-generate-with-openssl-rand-hex-32

# JWT signing secret for gateway tokens (REQUIRED)
GATEWAY_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Redis password (leave empty for no password in isolated networks)
REDIS_PASSWORD=

# =============================================================================
# IMAGE VERSIONS - Pin for reproducibility or use "latest" / "main"
# =============================================================================

OLLAMA_VERSION=latest
LITELLM_VERSION=main-latest
OPENWEBUI_VERSION=main
CHROMADB_VERSION=latest
REDIS_VERSION=7-alpine
NETDATA_VERSION=stable

# =============================================================================
# HOST PORT MAPPING - Change if ports conflict with existing services
# =============================================================================

OLLAMA_HOST_PORT=11434
LITELLM_HOST_PORT=4000
OPENWEBUI_HOST_PORT=3000
CHROMADB_HOST_PORT=8100
REDIS_HOST_PORT=6379
GATEWAY_HOST_PORT=8080
NETDATA_HOST_PORT=19999

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================

# Max models loaded in memory simultaneously (lower = less RAM)
OLLAMA_MAX_LOADED_MODELS=2

# Max parallel requests per model
OLLAMA_NUM_PARALLEL=2

# Enable flash attention (faster inference on supported hardware)
OLLAMA_FLASH_ATTENTION=1

# How long to keep models in memory after last request
OLLAMA_KEEP_ALIVE=5m

# Memory limits (adjust based on your system RAM)
OLLAMA_MEMORY_RESERVATION=4G
OLLAMA_MEMORY_LIMIT=12G

# =============================================================================
# LITELLM CONFIGURATION
# =============================================================================

LITELLM_LOG_LEVEL=INFO

# =============================================================================
# OPEN WEBUI CONFIGURATION
# =============================================================================

# Display name in the UI
OPENWEBUI_NAME=Homelab AI

# Enable user authentication
OPENWEBUI_AUTH=true

# Allow new user signups (disable for private instances)
OPENWEBUI_ENABLE_SIGNUP=false

# Default model shown in the UI
OPENWEBUI_DEFAULT_MODEL=llama3.1:8b

# Embedding model for RAG
OPENWEBUI_EMBEDDING_MODEL=nomic-embed-text

# Enable web search in RAG (requires additional config)
OPENWEBUI_ENABLE_WEB_SEARCH=false

# Allow admin data export
OPENWEBUI_ENABLE_EXPORT=true

# =============================================================================
# CHROMADB CONFIGURATION
# =============================================================================

# Authentication (leave empty for no auth in isolated networks)
CHROMADB_AUTH_PROVIDER=
CHROMADB_AUTH_CREDENTIALS=

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Maximum memory allocation for Redis
REDIS_MAX_MEMORY=256mb

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================

# Log level: debug, info, warning, error
GATEWAY_LOG_LEVEL=info

# JWT token expiry (hours)
GATEWAY_JWT_EXPIRY_HOURS=24

# Rate limits per API key
GATEWAY_RATE_LIMIT_RPM=60
GATEWAY_RATE_LIMIT_TPM=100000

# Cost tracking (per 1K tokens) - set to 0 for local models
GATEWAY_COST_INPUT=0.0
GATEWAY_COST_OUTPUT=0.0

# CORS allowed origins (comma-separated, * for all)
GATEWAY_CORS_ORIGINS=*

# =============================================================================
# NETDATA CONFIGURATION
# =============================================================================

# Netdata Cloud claim token (optional - for cloud dashboard)
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=

# =============================================================================
# NVIDIA GPU (uncomment and configure if applicable)
# =============================================================================

# NVIDIA_VISIBLE_DEVICES=all
# CUDA_VISIBLE_DEVICES=0
